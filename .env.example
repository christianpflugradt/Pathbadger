API_PORT=3001
GRAPHHOPPER_URL=http://graphhopper:8989
TILESERVER_URL=http://tileserver:8080
PUBLIC_API_BASE_URL=http://localhost:3001
# Default local app boot uses a bundled fallback style so the map can load
# without the optional TileServer profile. Override this with a self-hosted
# tile-stack style JSON endpoint when that stack is available.
PUBLIC_TILE_STYLE_URL=/styles/local-fallback.json
REGION_NAME=Schleswig-Holstein
MAX_TARGET_DISTANCE_KM=80
DEFAULT_DISTANCE_TOLERANCE_METERS=150
